{% comment %}
============================================================================
  BRANDS WE POWER — homepage grid of co-branded client partners
============================================================================
  One card per client brand. Add a card per client in the theme editor
  (Add block → Brand). Each card links to that client's collection or page.
  Logo can come from an uploaded image OR a theme asset filename (same
  fallback pattern as the cobrand product section).
============================================================================
{% endcomment %}

<style>
  .bwp-section {
    max-width: 1280px; margin: 0 auto; padding: 64px 24px;
    text-align: center;
  }
  .bwp-eyebrow {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
    color: #b08d57; margin: 0 0 10px;
  }
  .bwp-heading {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(28px, 4vw, 44px); color: #002850; margin: 0 0 14px;
  }
  .bwp-sub {
    font-family: var(--font-body--family, sans-serif);
    font-size: 16px; line-height: 1.6; color: #555;
    max-width: 640px; margin: 0 auto 42px;
  }
  .bwp-grid {
    display: grid; gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 360px));
    justify-content: center;
  }
  .bwp-card {
    border: 1px solid #e7e0d2; border-radius: 10px; background: #fff;
    padding: 36px 28px 30px; text-decoration: none; color: inherit;
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    transition: box-shadow .18s, transform .18s;
  }
  .bwp-card:hover { box-shadow: 0 10px 28px rgba(0,40,80,.10); transform: translateY(-2px); }
  .bwp-logo { height: 48px; display: flex; align-items: center; }
  .bwp-logo img { max-height: 48px; max-width: 220px; width: auto; }
  .bwp-name {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 22px; color: #2b2b2b; margin: 0;
  }
  .bwp-tag {
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px; line-height: 1.55; color: #666; margin: 0;
  }
  .bwp-cta {
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px; font-weight: 600; color: #b08d57; margin-top: 4px;
  }
  .bwp-card:hover .bwp-cta { text-decoration: underline; }
  .bwp-powered {
    font-family: var(--font-body--family, sans-serif);
    font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
    color: #9a9a9a; margin-top: 8px;
  }
</style>

<div class="bwp-section">
  {%- if section.settings.eyebrow != blank -%}
    <p class="bwp-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="bwp-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subtext != blank -%}
    <p class="bwp-sub">{{ section.settings.subtext }}</p>
  {%- endif -%}

  <div class="bwp-grid">
    {%- for block in section.blocks -%}
      <a class="bwp-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
          <span class="bwp-logo">
            {{ block.settings.logo | image_url: width: 440 | image_tag: alt: block.settings.name, loading: 'lazy' }}
          </span>
        {%- elsif block.settings.logo_asset != blank -%}
          <span class="bwp-logo">
            <img src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          </span>
        {%- else -%}
          <h3 class="bwp-name">{{ block.settings.name }}</h3>
        {%- endif -%}
        {%- if block.settings.tagline != blank -%}
          <p class="bwp-tag">{{ block.settings.tagline }}</p>
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <span class="bwp-cta">{{ block.settings.cta_label }} &rarr;</span>
        {%- endif -%}
        <span class="bwp-powered">Powered by Go-To Gifting</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Brands We Power",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Partner Brands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands we power" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "We bring beloved brands' gifts to your door — including wine and spirits pairings they can't ship themselves. One trusted checkout, fully licensed and compliant." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Client Brand" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "logo_asset", "label": "Logo asset filename", "info": "Fallback: a file in the theme's assets folder." },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "url", "id": "link", "label": "Link (collection or page)" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the collection" }
      ]
    }
  ],
  "presets": [{ "name": "Brands We Power", "blocks": [{ "type": "brand" }] }]
}
{% endschema %}
